# Copy values from your managed PostgreSQL provider. Use a pooled URL at runtime and a direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Local-only, synthetic two-hospital PostgreSQL integration test connections.
TENANT_ISOLATION_TEST_APP_URL=postgresql://jr_xpert_app:jr_xpert_app_test@127.0.0.1:5433/jr_xpert_hms_test?schema=public
TENANT_ISOLATION_TEST_OWNER_URL=postgresql://jr_xpert_test_owner:jr_xpert_test_owner_dev@127.0.0.1:5433/jr_xpert_hms_test?schema=public
API_PORT=4000
DB_POOL_MAX=5
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
JR_XPERT_API_URL=http://localhost:4000/api/v1
AUTH_RATE_LIMIT_SECRET=replace_with_a_cryptographically_random_secret_of_at_least_32_characters
MFA_ENCRYPTION_KEY=replace_with_64_random_hex_characters
RESEND_API_KEY=replace_with_provider_key_if_recovery_email_is_enabled
AUTH_EMAIL_FROM=JR Xpert HMS <no-reply@example.com>

# First Super Admin bootstrap only. Use a separate migration/owner role locally, never as the API runtime DATABASE_URL.
BOOTSTRAP_DATABASE_URL=postgresql://MIGRATION_USER:REPLACE_ME@HOST/neondb?sslmode=require
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=First Platform Administrator
BOOTSTRAP_CONFIRM=CREATE_FIRST_SUPER_ADMIN
