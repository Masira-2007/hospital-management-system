generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum HospitalApplicationStatus {
  EMAIL_PENDING
  PENDING_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum MembershipRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  ORGANIZATION_OWNER
  HOSPITAL_ADMIN
  HOSPITAL_MANAGER
  MEDICAL_DIRECTOR
  DOCTOR
  SPECIALIST_DOCTOR
  NURSE
  RECEPTIONIST
  PATIENT
  PHARMACIST
  PHARMACY_MANAGER
  LAB_TECHNICIAN
  LAB_MANAGER
  RADIOLOGIST
  BILLING_EXECUTIVE
  ACCOUNTANT
  CLAIMS_EXECUTIVE
  HR_MANAGER
  HOSPITAL_STAFF
  WARD_MANAGER
  OT_MANAGER
  INVENTORY_MANAGER
  AMBULANCE_OPERATOR
  SECURITY_AUDITOR
  REFERRING_DOCTOR
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  timezone    String       @default("Asia/Kolkata")
  currency    String       @default("INR")
  locale      String       @default("en-IN")
  status      TenantStatus @default(PROVISIONING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  hospitals   Hospital[]
  memberships Membership[]
  patients    Patient[]
  appointments Appointment[]
  auditEvents AuditEvent[]
  invitations HospitalInvitation[]
}

model Hospital {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  timezone       String        @default("Asia/Kolkata")
  currency       String        @default("INR")
  status         TenantStatus  @default(PROVISIONING)
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches       Branch[]
  memberships    Membership[]
  patients       Patient[]
  appointments   Appointment[]
  settings       HospitalSettings?
  subscriptions  HospitalSubscription[]
  sourceApplication HospitalApplication? @relation("ApplicationProvisionedHospital")
  invitations     HospitalInvitation[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model HospitalApplication {
  id                       String                    @id @default(cuid())
  status                   HospitalApplicationStatus @default(EMAIL_PENDING)
  hospitalName             String
  hospitalType             String
  officialEmail            String
  contactPhone             String
  website                  String?
  streetAddress            String
  city                     String
  state                    String
  country                  String
  postalCode               String
  bedCount                 Int
  branchCount              Int
  representativeName       String
  representativeDesignation String
  proposedAdminName        String
  proposedAdminEmail       String
  requestedPlanCode        String?
  termsAcceptedAt          DateTime
  verificationTokenHash    String?                   @unique
  verificationExpiresAt    DateTime?
  emailVerifiedAt          DateTime?
  reviewedAt               DateTime?
  reviewedByUserId         String?
  reviewReason             String?
  createdHospitalId        String?                   @unique
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  reviewer                 User?                     @relation("HospitalApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  createdHospital          Hospital?                 @relation("ApplicationProvisionedHospital", fields: [createdHospitalId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([officialEmail, status])
  @@index([proposedAdminEmail, status])
}

model HospitalInvitation {
  id              String           @id @default(cuid())
  organizationId  String
  hospitalId      String
  createdByUserId String
  preparedUserId  String?
  intendedEmail   String
  intendedName    String
  role            MembershipRole   @default(HOSPITAL_ADMIN)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  deliveryStatus  DeliveryStatus   @default(PENDING)
  expiresAt       DateTime
  preparedAt      DateTime?
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hospital        Hospital         @relation(fields: [hospitalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy       User             @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  preparedUser    User?            @relation("InvitationPreparedUser", fields: [preparedUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId, status, expiresAt])
  @@index([intendedEmail, status])
}

model Branch {
  id         String        @id @default(cuid())
  hospitalId String
  name       String
  code       String
  timezone   String        @default("Asia/Kolkata")
  status     TenantStatus  @default(PROVISIONING)
  createdAt  DateTime      @default(now())
  hospital   Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  memberships Membership[]
  patients    Patient[]
  appointments Appointment[]

  @@unique([hospitalId, code])
  @@unique([id, hospitalId])
  @@index([hospitalId])
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  phone           String?
  passwordHash    String
  displayName     String
  status          AccountStatus @default(INVITED)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  mfaEnabled      Boolean      @default(false)
  mfaSecretEncrypted String?
  mfaLastUsedCounter BigInt?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  auditEvents     AuditEvent[]
  sessions        Session[]
  passwordResetTokens PasswordResetToken[]
  loginVerificationCodes LoginVerificationCode[]
  externalIdentities ExternalIdentity[]
  patientAccessGrants PatientAccessGrant[]
  reviewedApplications HospitalApplication[] @relation("HospitalApplicationReviewer")
  createdInvitations HospitalInvitation[] @relation("InvitationCreator")
  preparedInvitations HospitalInvitation[] @relation("InvitationPreparedUser")
  platformBootstrapTokens PlatformBootstrapToken[]

  @@index([status])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  hospitalId     String?
  branchId       String?
  role           MembershipRole
  roleDefinition Role          @relation(fields: [role], references: [code], onDelete: Restrict)
  status         AccountStatus  @default(INVITED)
  department     String?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hospital       Hospital?      @relation(fields: [hospitalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch         Branch?        @relation(fields: [branchId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  appointments   Appointment[]  @relation("AppointmentDoctor")
  activeSessions Session[]     @relation("SessionActiveMembership")

  @@unique([userId, organizationId, hospitalId, branchId, role])
  @@unique([id, organizationId])
  @@index([organizationId, hospitalId, branchId, status])
  @@index([userId, status])
}

model Patient {
  id             String        @id @default(cuid())
  organizationId String
  hospitalId     String
  branchId       String?
  mrn            String
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hospital       Hospital     @relation(fields: [hospitalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch         Branch?      @relation(fields: [branchId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  appointments   Appointment[]
  accessGrants   PatientAccessGrant[]

  @@unique([organizationId, mrn])
  @@unique([id, organizationId])
  @@index([organizationId, hospitalId, lastName, firstName])
  @@index([organizationId, phone])
}

model Appointment {
  id                    String            @id @default(cuid())
  organizationId        String
  hospitalId            String
  branchId              String?
  patientId             String
  doctorMembershipId    String
  startsAt              DateTime
  durationMinutes       Int               @default(20)
  status                AppointmentStatus @default(REQUESTED)
  reason                String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hospital              Hospital         @relation(fields: [hospitalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch                Branch?          @relation(fields: [branchId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  patient               Patient          @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  doctor                Membership       @relation("AppointmentDoctor", fields: [doctorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, hospitalId, startsAt, status])
  @@index([organizationId, patientId, startsAt])
  @@index([organizationId, doctorMembershipId, startsAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  reason         String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
    @@index([createdAt(sort: Desc), id(sort: Desc)])
    @@index([action, createdAt(sort: Desc)])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembershipId String?
  activeMembership   Membership? @relation("SessionActiveMembership", fields: [activeMembershipId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([activeMembershipId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model LoginVerificationCode {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  codeHash       String
  mode           String
  rememberMe     Boolean   @default(false)
  failedAttempts Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model OAuthLoginTransaction {
  id            String   @id @default(cuid())
  provider      String
  mode          String
  stateHash     String   @unique
  nonceHash     String
  codeChallenge String
  rememberMe    Boolean  @default(false)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([expiresAt, usedAt])
}

model ExternalIdentity {
  id        String   @id @default(cuid())
  provider  String
  subject   String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([userId])
}

model Role {
  code           MembershipRole @id
  name           String
  description    String?
  platformScoped Boolean        @default(false)
  memberships    Membership[]
  permissions    RolePermission[]
}

model Permission {
  code        String           @id
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleCode     MembershipRole @map("role")
  permissionId String
  role         Role           @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionId])
  @@index([permissionId])
}

model HospitalSettings {
  id              String   @id @default(cuid())
  hospitalId      String   @unique
  timezone        String   @default("Asia/Kolkata")
  currency        String   @default("INR")
  locale          String   @default("en-IN")
  invoiceSettings Json?
  taxSettings     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
}

model SubscriptionPlan {
  id           String                 @id @default(cuid())
  code         String                 @unique
  name         String
  active       Boolean                @default(true)
  entitlements Json
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  subscriptions HospitalSubscription[]
}

model HospitalSubscription {
  id                 String             @id @default(cuid())
  organizationId     String
  hospitalId         String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  hospital           Hospital           @relation(fields: [hospitalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, hospitalId, status])
  @@index([status, currentPeriodEnd])
}

model PatientAccessGrant {
  id             String    @id @default(cuid())
  userId         String
  patientId      String
  organizationId String
  relationship   String    @default("SELF")
  canViewRecords Boolean   @default(false)
  canManageCare  Boolean   @default(false)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  patient        Patient   @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([userId, patientId])
  @@index([userId, organizationId, revokedAt])
  @@index([patientId, organizationId, revokedAt])
}

model AuthRateLimit {
  keyHash         String   @id
  failedAttempts  Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

model PlatformBootstrapToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  preparedAt DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}
