{
  "name": "@jr-xpert/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "start:dev": "tsx watch src/main.mts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.mjs",
    "test": "tsx --test test/health.spec.ts test/security.spec.ts test/tenant-membership.spec.ts test/patients.spec.ts test/appointments.spec.ts test/patient-registration.spec.ts test/authentication.spec.ts test/onboarding.spec.ts",
    "test:tenant-isolation": "tsx --test test/tenant-isolation.integration.spec.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:verify-runtime-role": "tsx src/scripts/verify-runtime-role.mts",
    "admin:bootstrap": "tsx src/scripts/bootstrap-super-admin.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
